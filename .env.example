# Kopieer naar .env.local en vul in. .env.local staat in .gitignore.
# ---------------------------------------------------------------------------

# --- Supabase (stap A1) ---------------------------------------------------
# We draaien in het bestaande CMS-project, in een eigen schema.
# Vergeet niet 'mi' aan te zetten bij Project Settings -> API -> Exposed schemas.
SUPABASE_DB_SCHEMA=mi

# Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# "anon public" — mag in de browser
SUPABASE_ANON_KEY=
# "service_role" — HOOFDSLEUTEL. Alleen server-side. Nooit in een website,
# nooit in een chatbericht, nooit in git.
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings -> Database -> Connection string (voor migraties)
SUPABASE_DB_URL=postgresql://postgres:WACHTWOORD@db.xxxx.supabase.co:5432/postgres

# --- Google Ads (bestaat al in CP\GoogleAds\google-ads.yaml) --------------
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# MCC zonder streepjes
GOOGLE_ADS_LOGIN_CUSTOMER_ID=9287874539

# --- GA4 (stap A2) --------------------------------------------------------
# Pad naar het service-account JSON-bestand
GOOGLE_APPLICATION_CREDENTIALS=./secrets/ga4.json

# --- Mailparser (stap A4) -------------------------------------------------
# microsoft | gmail
MAIL_PROVIDER=
MAIL_USER=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=

# --- Collector ------------------------------------------------------------
# Wordt per website gezet in Vercel, niet hier.
